<?xml version="1.0" encoding="utf-8"?>
<!-- Atalho: as Definicoes da TV (firmware HK1) abrem "Atualizacao do sistema" chamando explicitamente
     com.dtinfo.tools/.activity.MainActivity (o atualizador antigo do fabricante, removido da imagem).
     Esta app minima tem esse nome e so abre o A95X Z2 Updater. Sem permissoes, sem ecra. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dtinfo.tools" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="29" />
    <application android:label="@string/app_name" android:allowBackup="false" android:hasCode="true">
        <activity android:name=".activity.MainActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true"
            android:noHistory="true" />
    </application>
</manifest>
